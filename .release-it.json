{
  "git": {
    "commit": true,
    "commitMessage": "chore: release v${version}",
    "tag": true,
    "tagName": "v${version}",
    "push": true,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "header": "# Changelog\n\nAll notable changes to this project will be documented in this file. See [Conventional Commits](https://www.conventionalcommits.org/) for commit guidelines.",
      "preset": {
        "name": "conventionalcommits",
        "types": [
          { "type": "chore", "section": "🧹 Chore", "hidden": false },
          { "type": "types", "section": "💙 Types", "hidden": false },
          { "type": "revert", "section": "♻ Reverts", "hidden": false },
          { "type": "feat", "section": "🚀 Features", "hidden": false },
          { "type": "fix", "section": "🐛 Bug Fixes", "hidden": false },
          {
            "type": "improvement",
            "section": "🌟 Feature Improvements",
            "hidden": false
          },
          { "type": "docs", "section": "📖 Documentation", "hidden": false },
          { "type": "style", "section": "☯ Styling", "hidden": false },
          {
            "type": "refactor",
            "section": "🔧 Code Refactoring",
            "hidden": false
          },
          {
            "type": "perf",
            "section": "💪 Performance Improvements",
            "hidden": false
          },
          { "type": "test", "section": "🐱‍💻 Tests", "hidden": false },
          { "type": "build", "section": "🔨 Build System", "hidden": false },
          { "type": "ci", "section": "🛠️ CI", "hidden": false }
        ]
      }
    }
  }
}
